{
  "name": "@cognitive-substrate/ingest-worker",
  "version": "0.1.0",
  "description": "Kafka consumer that translates blog TelemetryEvents into ExperienceEvents and indexes them into OpenSearch",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "node --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@cognitive-substrate/core-types": "workspace:*",
    "@cognitive-substrate/kafka-bus": "workspace:*",
    "@cognitive-substrate/memory-opensearch": "workspace:*",
    "@opensearch-project/opensearch": "^2.7.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
