# Kafka broker — use "thor:9092" from the VPS (via Cloudflare Tunnel),
# "localhost:9092" when running the worker directly on thor.
KAFKA_BROKERS=thor:9092
KAFKA_CLIENT_ID=ingest-worker
KAFKA_GROUP_ID=ingest-worker-group
KAFKA_TOPIC_REPLICATION_FACTOR=1

# OpenSearch — always local on thor
OPENSEARCH_URL=http://thor:9200

# Tuning
WRITER_BUFFER_SIZE=50
WRITER_FLUSH_MS=5000
