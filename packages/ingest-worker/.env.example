# Ingest worker — runs on thor, connects to Kafka on the internal plaintext listener.
# External clients (blog VPS) use SASL_SSL on 9092; the worker on the same
# Docker network uses the plaintext listener on 9094.

KAFKA_BROKERS=kafka:9094
KAFKA_CLIENT_ID=ingest-worker
KAFKA_GROUP_ID=ingest-worker-group
KAFKA_TOPIC_REPLICATION_FACTOR=1

# OpenSearch — always local on thor
OPENSEARCH_URL=http://thor:9200

# Tuning
WRITER_BUFFER_SIZE=50
WRITER_FLUSH_MS=5000

# ---- Blog VPS / external client config (not used by the worker itself) ----
# KAFKA_BROKERS=thor.bigpines.net:9092
# KAFKA_SSL=true
# KAFKA_CA_CERT=<contents of ~/kafka-tls/ca.crt>
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=blog
# KAFKA_SASL_PASSWORD=kafkapass
