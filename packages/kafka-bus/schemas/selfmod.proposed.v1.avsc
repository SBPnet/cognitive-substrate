{
  "namespace": "io.cognitive-substrate",
  "type": "record",
  "name": "SelfModificationProposal",
  "doc": "Self-modification proposal generated by the meta-cognition engine. payload is JSON-serialized because ProposalPayload is a discriminated union. Mirrors packages/core-types/src/reinforcement.ts SelfModificationProposal.",
  "fields": [
    { "name": "mutationId", "type": "string" },
    { "name": "timestamp", "type": "string" },
    {
      "name": "mutationType",
      "type": {
        "type": "enum",
        "name": "ProposalKind",
        "symbols": [
          "parameter_tune",
          "plugin_register",
          "plugin_update",
          "index_mapping",
          "metric_capture"
        ]
      }
    },
    { "name": "description", "type": "string" },
    { "name": "expectedGain", "type": "double" },
    { "name": "stabilityRisk", "type": "double" },
    { "name": "approved", "type": "boolean" },
    { "name": "rollbackAvailable", "type": "boolean" },
    {
      "name": "payload",
      "type": "string",
      "doc": "JSON-serialized ProposalPayload (ParameterTunePayload | PluginProposalPayload | IndexMappingPayload)"
    },
    { "name": "observedGain", "type": ["null", "double"], "default": null }
  ]
}
