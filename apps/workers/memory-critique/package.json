  "description": "Memory Critique Worker — consumes MemoryCritiqueEvents and applies trust score decrements, suppression threshold raises, early re-consolidation triggers, and abstraction ladder cascade",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
