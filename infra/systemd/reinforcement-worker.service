[Unit]
Description=Cognitive Substrate Reinforcement Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/steve/Workspace/cognitive-substrate/apps/workers/reinforcement
ExecStart=/home/steve/.nvm/versions/node/v22.22.0/bin/node dist/main.js
Restart=always
RestartSec=10
Environment=KAFKA_BROKERS=100.113.192.75:9092
Environment=KAFKA_CLIENT_ID=reinforcement-worker
Environment=OPENSEARCH_URL=http://localhost:9200
Environment=CLICKHOUSE_URL=http://localhost:8123

[Install]
WantedBy=multi-user.target
