[Unit]
Description=Cognitive Substrate Orchestrator (CognitiveLoop)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/steve/Workspace/cognitive-substrate/apps/orchestrator
ExecStart=/home/steve/.nvm/versions/node/v22.22.0/bin/node dist/main.js
Restart=always
RestartSec=10
Environment=KAFKA_BROKERS=100.113.192.75:9092
Environment=KAFKA_CLIENT_ID=orchestrator
Environment=KAFKA_TOPIC_REPLICATION_FACTOR=1
Environment=OPENSEARCH_URL=http://localhost:9200
# Use OpenSearch ML node for query embeddings — all-mpnet-base-v2 (768-dim)
Environment=EMBEDDING_PROVIDER=opensearch
Environment=OPENSEARCH_MODEL_ID=YYGXOJ4BgYB_vs2klaSo
Environment=EMBEDDING_DIMENSION=768
Environment=HEALTH_PORT=3006

[Install]
WantedBy=multi-user.target
